# Leave empty to call the API on the same origin (dev proxy / nginx). Set for a separate API host.
VITE_API_BASE_URL=
# Google Identity Services client id; empty hides the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=
# Chrome extension IDs the web app may hand a session to (comma-separated). Empty: the development build's ID.
# Add the Chrome Web Store ID once the extension is published.
VITE_EXTENSION_IDS=
