# Copy to .env and fill in. Never commit .env.
# Variables marked (later) are read by services not yet in docker-compose; listed now so the contract is visible.

# --- Postgres (container admin; each service has its own role created by docker/postgres/init.sql) ---
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me
AUTH_DB_PASSWORD=auth_svc
PROFILE_DB_PASSWORD=profile_svc
INGESTION_DB_PASSWORD=ingestion_svc
JOB_DB_PASSWORD=job_svc
REFERRAL_DB_PASSWORD=referral_svc
TRACKER_DB_PASSWORD=tracker_svc
NOTIFICATION_DB_PASSWORD=notification_svc
ANALYZER_DB_PASSWORD=analyzer_svc

# --- JWT (auth-service signs, everyone else verifies via JWKS) ---
# Leave empty locally: auth-service generates a key pair once and keeps it in the authkeys volume.
# Production: PKCS#8 private + X.509 public PEM, raw or base64-encoded on one line. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
#   base64 -w0 jwt-private.pem   /   base64 -w0 jwt-public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=referboard-auth
JWT_AUDIENCE=referboard
# A rotated refresh token presented again within this window (reload mid-refresh, two tabs) gets a new token
# instead of revoking the session. After it, or once its successor was used, reuse revokes the session.
JWT_REFRESH_REUSE_GRACE=PT30S

# --- Google sign-in (OAuth client of type "Web application"; add http://localhost:3000 (and :5173 for npm run dev) as authorised JS origins) ---
GOOGLE_CLIENT_ID=
AUTH_COOKIE_SECURE=true

# --- LLM + embeddings (profile now; later ingestion, referral, resume-analyzer) ---
# auto = Anthropic if ANTHROPIC_API_KEY is set, else OpenAI if OPENAI_API_KEY is set, else offline fallbacks
# (heuristic resume parser + hashing embeddings), so everything runs with no keys at all.
# Embeddings need OpenAI (Anthropic has no embeddings API); without it the hashing fallback is used.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small

# --- Job sources (ingestion-service) ---
# Adzuna is skipped when keys are empty. Greenhouse/Lever/Ashby public board APIs need no keys.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
INGESTION_CRON=0 0 */6 * * *
# Identify the crawler honestly and give a contact URL; robots.txt rules are matched on the first token.
INGESTION_USER_AGENT=ReferBoardBot/0.1 (+https://github.com/your-org/referboard)
# Fictional sample jobs for local dev. Never enable in production.
INGESTION_SAMPLE_DATA=true
INGESTION_RUN_ON_STARTUP=true

# --- File storage (profile now; later resume-analyzer). local | s3 (AWS S3, MinIO, R2) ---
STORAGE_TYPE=local
S3_REGION=us-east-1
S3_PATH_STYLE=true
S3_ENDPOINT=
S3_BUCKET=referboard-resumes
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- JD Match Analyzer ---
# Free-tier analyses per user per month (PRO and ADMIN roles are unlimited). Identical re-runs within 24h are free.
ANALYZER_FREE_PER_MONTH=5

# --- Email (notification-service), plain SMTP ---
# Local: Mailpit from docker-compose catches everything (UI at http://localhost:8025).
# Production: any SMTP relay works, e.g. Resend (smtp.resend.com:587, user "resend", password = API key),
# SendGrid (smtp.sendgrid.net:587, user "apikey"), Amazon SES or Postmark. Use SMTP_AUTH=true, SMTP_STARTTLS=true.
# Empty SMTP_HOST: emails are rendered and stored as SKIPPED (visible in notification.email_deliveries), not sent.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=ReferBoard <noreply@referboard.local>
MAX_EMAILS_PER_USER_PER_DAY=20
# Links in emails: the frontend, and the public API (gateway) for one-click unsubscribe.
APP_BASE_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:3000

# --- API gateway ---
# Only needed for origins other than the frontend container (which is same-origin), e.g. `npm run dev` on :5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (nginx serving the React app, proxying /api to the gateway) ---
FRONTEND_PORT=3000
# Requests per minute: per user (or IP when signed out); sign-in per IP; LLM-backed calls per user.
RATE_LIMIT_REQUESTS_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
EXPENSIVE_RATE_LIMIT_PER_MINUTE=10
# The gateway sits behind the frontend's nginx (which overwrites X-Forwarded-For with the client address), so it
# trusts that header for client IPs. Set false only if browsers reach the gateway directly. TRUSTED_PROXIES is a
# regex of addresses allowed to set X-Forwarded-* headers (default: loopback and private ranges).
TRUST_FORWARDED_FOR=true
# TRUSTED_PROXIES=10\.0\.0\.5   (example: only your load balancer)

# --- Logging: ecs | logstash | gelf (structured JSON). Empty = plain text ---
LOG_FORMAT=ecs
