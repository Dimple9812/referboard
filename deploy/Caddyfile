# HTTPS for the whole app. Caddy gets and renews a Let's Encrypt certificate for $DOMAIN automatically
# (ports 80 and 443 must be open and the domain's A record must point at this server).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	# Caddy discards any X-Forwarded-For the browser sends and sets the real client address; nginx trusts it.
	reverse_proxy frontend:80
}
