# ReferBoard production settings. deploy/setup.sh copied this to .env and filled in the domain and every
# secret marked "generated". Keep .env private (it's chmod 600 and git-ignored). After editing it, apply with:
#   ./deploy/rb up -d
# Values that are baked into the web app at build time (GOOGLE_CLIENT_ID) need a rebuild: ./deploy/update.sh

# --- Site ---
DOMAIN=__DOMAIN__
ACME_EMAIL=__EMAIL__                       # Let's Encrypt expiry notices
APP_BASE_URL=https://__DOMAIN__
PUBLIC_API_BASE_URL=https://__DOMAIN__
LOG_FORMAT=ecs

# --- Database (generated) ---
POSTGRES_ADMIN_PASSWORD=__GEN__
AUTH_DB_PASSWORD=__GEN__
PROFILE_DB_PASSWORD=__GEN__
JOB_DB_PASSWORD=__GEN__
INGESTION_DB_PASSWORD=__GEN__
REFERRAL_DB_PASSWORD=__GEN__
ANALYZER_DB_PASSWORD=__GEN__
TRACKER_DB_PASSWORD=__GEN__
NOTIFICATION_DB_PASSWORD=__GEN__
BILLING_DB_PASSWORD=__GEN__
INTERVIEW_DB_PASSWORD=__GEN__
ANALYTICS_DB_PASSWORD=__GEN__

# --- Sign-in tokens (generated RSA key pair, base64 PEM). Changing them signs everyone out. ---
JWT_PRIVATE_KEY=__JWT_PRIVATE__
JWT_PUBLIC_KEY=__JWT_PUBLIC__

# --- Google sign-in (optional) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised JavaScript origin: https://__DOMAIN__  . Then run ./deploy/update.sh (the web app embeds it).
GOOGLE_CLIENT_ID=

# --- AI (optional; everything works without, with simpler parsing and template drafts) ---
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
EMBEDDING_PROVIDER=auto

# --- Payments: Razorpay (optional; Pro shows as unavailable until set) ---
# Dashboard → Account & Settings → API Keys. Start with test keys (rzp_test_...).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → Add: URL https://__DOMAIN__/api/billing/webhooks/razorpay,
# events payment.captured, order.paid, refund.processed; paste the same secret here.
RAZORPAY_WEBHOOK_SECRET=
PRO_MONTH_PRICE_PAISE=29900
PRO_YEAR_PRICE_PAISE=249900

# --- Email (optional; without SMTP_HOST, emails are stored as skipped instead of sent) ---
# Any SMTP relay, e.g. Brevo's free plan (smtp-relay.brevo.com:587) or Resend (smtp.resend.com:587, user "resend").
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=ReferBoard <noreply@__DOMAIN__>

# --- Jobs ---
# Adzuna's free API adds India listings beyond company career boards (https://developer.adzuna.com).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
INGESTION_CRON=0 0 */6 * * *

# --- Demo for visitors (optional) ---
# A shared account anyone can open with "Try the demo", filled with fictional data. Set an address nobody uses,
# apply with ./deploy/rb up -d auth-service, then run ./deploy/seed-demo.sh. Empty = no demo.
DEMO_ACCOUNT_EMAIL=

# --- Limits ---
ANALYZER_FREE_PER_MONTH=5
ANALYZER_AI_LETTERS_PER_DAY=20
INTERVIEW_FREE_PACKS_PER_MONTH=3
RATE_LIMIT_REQUESTS_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
EXPENSIVE_RATE_LIMIT_PER_MINUTE=10

# --- Backups (optional off-server copy; see docs/DEPLOY-ORACLE.md, "Backups") ---
# An rclone remote and bucket, e.g. oci:referboard-backups. Empty: backups stay on this server only.
BACKUP_REMOTE=
